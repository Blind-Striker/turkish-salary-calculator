  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\year-constants.json" Link="Assets\year-constants.json" LogicalName="Turkish.HRSolutions.SalaryCalculator.Assets.year-constants.json" />
    <EmbeddedResource Include="..\..\assets\calculation-constants.json" Link="Assets\calculation-constants.json" LogicalName="Turkish.HRSolutions.SalaryCalculator.Assets.calculation-constants.json" />
  </ItemGroup>
