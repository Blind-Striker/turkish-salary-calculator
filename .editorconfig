# =============================================================================
# .editorconfig - Turkish Salary Calculator
# =============================================================================
# Analyzers: Microsoft.CodeAnalysis.NetAnalyzers, Meziantou.Analyzer,
#            Roslynator, SonarAnalyzer, VSTHRD, BannedApiAnalyzers
# =============================================================================
# Top-most http://editorconfig.org/ file
root = true

# =============================================================================
# SECTION 1: FILE TYPE SETTINGS
# =============================================================================

[*]
insert_final_newline = true
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
max_line_length = 180

[*.cs]
indent_size = 4

[*.{xml,config,*proj,nuspec,props,resx,targets,yml,tasks}]
indent_size = 2

[*.{props,targets,ruleset,config,nuspec,resx,vsixmanifest,vsct}]
indent_size = 2

[*.json]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4

[*.sh]
indent_size = 4

# =============================================================================
# SECTION 2: C#/VB LANGUAGE PREFERENCES
# =============================================================================
[*.{cs,vb}]

# -----------------------------------------------------------------------------
# 2.1 Naming Conventions
# -----------------------------------------------------------------------------
dotnet_naming_symbols.local_symbol.applicable_kinds = parameter, local
dotnet_naming_style.local_style.capitalization = camel_case
dotnet_naming_rule.variables_are_camel_case.severity = error
dotnet_naming_rule.variables_are_camel_case.symbols = local_symbol
dotnet_naming_rule.variables_are_camel_case.style = local_style

# -----------------------------------------------------------------------------
# 2.2 Using Directives
# -----------------------------------------------------------------------------
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true

# -----------------------------------------------------------------------------
# 2.3 Qualification Preferences (this./Me.)
# -----------------------------------------------------------------------------
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# -----------------------------------------------------------------------------
# 2.4 Type Preferences (keywords vs BCL)
# -----------------------------------------------------------------------------
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error

# -----------------------------------------------------------------------------
# 2.5 Modifier Preferences
# -----------------------------------------------------------------------------
dotnet_style_require_accessibility_modifiers = always:error
dotnet_style_readonly_field = true:error

# -----------------------------------------------------------------------------
# 2.6 Parentheses Preferences
# -----------------------------------------------------------------------------
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:error
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:error
dotnet_style_parentheses_in_other_operators = always_for_clarity:error
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:error

# -----------------------------------------------------------------------------
# 2.7 Unused Parameters
# -----------------------------------------------------------------------------
dotnet_code_quality_unused_parameters = all

# -----------------------------------------------------------------------------
# 2.8 Multiple Blank Lines
# -----------------------------------------------------------------------------
dotnet_style_allow_multiple_blank_lines_experimental = false

# =============================================================================
# SECTION 3: C# FORMATTING
# =============================================================================

# -----------------------------------------------------------------------------
# 3.1 var Preferences
# -----------------------------------------------------------------------------
csharp_style_var_elsewhere = true:error
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error

# -----------------------------------------------------------------------------
# 3.2 Newline Settings
# -----------------------------------------------------------------------------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# -----------------------------------------------------------------------------
# 3.3 Indentation
# -----------------------------------------------------------------------------
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_labels = one_less_than_current
csharp_indent_switch_labels = true

# -----------------------------------------------------------------------------
# 3.4 Spacing
# -----------------------------------------------------------------------------
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false
csharp_max_attribute_length_for_same_line = 80

# -----------------------------------------------------------------------------
# 3.5 Braces
# -----------------------------------------------------------------------------
csharp_prefer_braces = true:error

# -----------------------------------------------------------------------------
# 3.6 Using Directive Placement
# -----------------------------------------------------------------------------
csharp_using_directive_placement = outside_namespace:error

# -----------------------------------------------------------------------------
# 3.7 Wrapping (ReSharper)
# -----------------------------------------------------------------------------
resharper_wrap_object_and_collection_initializer_style = chop_always

# =============================================================================
# SECTION 4: C#-SPECIFIC PREFERENCES
# =============================================================================
[*.cs]

# -----------------------------------------------------------------------------
# 4.1 Namespace Declarations
# -----------------------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:error

# -----------------------------------------------------------------------------
# 4.2 Pattern Matching
# -----------------------------------------------------------------------------
csharp_style_pattern_matching_over_is_with_cast_check = true:error
csharp_style_pattern_matching_over_as_with_null_check = true:error
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:error
csharp_style_prefer_extended_property_pattern = true:suggestion

# -----------------------------------------------------------------------------
# 4.3 Expression-bodied Members
# -----------------------------------------------------------------------------
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_indexers = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# -----------------------------------------------------------------------------
# 4.4 Null Checking
# -----------------------------------------------------------------------------
csharp_style_throw_expression = true:error
csharp_style_conditional_delegate_call = true:error

# -----------------------------------------------------------------------------
# 4.5 Local Functions & Using Statements
# -----------------------------------------------------------------------------
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_static_local_function = true:error

# -----------------------------------------------------------------------------
# 4.6 Roslynator Configuration
# -----------------------------------------------------------------------------
# Enable refactorings and compiler fixes in IDE (no build impact)
dotnet_analyzer_diagnostic.category-roslynator.severity = error
roslynator_analyzers.enabled_by_default = true
roslynator_refactorings.enabled = true
roslynator_compiler_diagnostic_fixes.enabled = true

# =============================================================================
# SECTION 5: IDE STYLE ANALYZERS (IDE0xxx)
# =============================================================================

# -----------------------------------------------------------------------------
# 5.1 Simplification Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0001.severity = error  # Simplify name
dotnet_diagnostic.IDE0002.severity = error  # Simplify member access
dotnet_diagnostic.IDE0003.severity = error  # this/Me qualification
dotnet_diagnostic.IDE0004.severity = error  # Remove unnecessary cast
dotnet_diagnostic.IDE0034.severity = error  # Simplify 'default' expression
dotnet_diagnostic.IDE0035.severity = error  # Remove unreachable code
dotnet_diagnostic.IDE0071.severity = error  # Simplify interpolation
dotnet_diagnostic.IDE0075.severity = error  # Simplify conditional expression
dotnet_diagnostic.IDE0080.severity = error  # Remove unnecessary suppression operator
dotnet_diagnostic.IDE0082.severity = error  # Convert typeof to nameof
dotnet_diagnostic.IDE0090.severity = error  # Simplify new expression
dotnet_diagnostic.IDE0100.severity = error  # Remove unnecessary equality operator
dotnet_diagnostic.IDE0110.severity = error  # Remove unnecessary discard
dotnet_diagnostic.IDE0120.severity = error  # Simplify LINQ expression

# -----------------------------------------------------------------------------
# 5.2 Unused Code Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0005.severity = error  # Remove unnecessary usings
dotnet_diagnostic.IDE0051.severity = error  # Remove unused private members
dotnet_diagnostic.IDE0052.severity = error  # Remove unread private members
dotnet_diagnostic.IDE0059.severity = error  # Unnecessary assignment to a value
dotnet_diagnostic.IDE0060.severity = error  # Remove unused parameter

# -----------------------------------------------------------------------------
# 5.3 Modern Syntax Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0017.severity = error  # Use object initializers
dotnet_diagnostic.IDE0018.severity = error  # Inline variable declaration
dotnet_diagnostic.IDE0028.severity = error  # Use collection initializers
dotnet_diagnostic.IDE0029.severity = error  # Use coalesce expression (non-nullable)
dotnet_diagnostic.IDE0030.severity = error  # Use coalesce expression (nullable)
dotnet_diagnostic.IDE0031.severity = error  # Use null propagation
dotnet_diagnostic.IDE0033.severity = error  # Use explicitly provided tuple name
dotnet_diagnostic.IDE0056.severity = error  # Use index operator
dotnet_diagnostic.IDE0057.severity = error  # Use range operator
dotnet_diagnostic.IDE0161.severity = error  # File-scoped namespace
dotnet_diagnostic.IDE0180.severity = error  # Use tuple to swap values
dotnet_diagnostic.IDE0200.severity = error  # Lambda expression can be removed

# -----------------------------------------------------------------------------
# 5.4 Pattern Matching Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0019.severity = error  # Use pattern matching (as + null)
dotnet_diagnostic.IDE0020.severity = error  # Use pattern matching (is + cast with var)
dotnet_diagnostic.IDE0038.severity = error  # Use pattern matching (is + cast without var)
dotnet_diagnostic.IDE0066.severity = error  # Use switch expression
dotnet_diagnostic.IDE0072.severity = error  # Add missing switch cases
dotnet_diagnostic.IDE0078.severity = error  # Use pattern matching
dotnet_diagnostic.IDE0083.severity = error  # Use pattern matching (not operator)

# -----------------------------------------------------------------------------
# 5.5 Readonly/Static Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0032.severity = suggestion  # Use auto property
dotnet_diagnostic.IDE0044.severity = error       # Make field readonly
dotnet_diagnostic.IDE0062.severity = error       # Make local function static
dotnet_diagnostic.IDE0250.severity = error       # Struct can be readonly
dotnet_diagnostic.IDE0251.severity = error       # Member can be readonly

# -----------------------------------------------------------------------------
# 5.6 Nullable Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0240.severity = error  # Nullable directive is redundant
dotnet_diagnostic.IDE0241.severity = error  # Nullable directive is unnecessary

# -----------------------------------------------------------------------------
# 5.7 Naming & Namespace Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE1006.severity = error  # Naming rule violation
dotnet_diagnostic.IDE0130.severity = error  # Namespace mismatch

# -----------------------------------------------------------------------------
# 5.8 Formatting & Style Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0007.severity = error  # 'var' preferences
dotnet_diagnostic.IDE0011.severity = error  # Curly braces
dotnet_diagnostic.IDE0036.severity = error  # Modifier order
dotnet_diagnostic.IDE0040.severity = error  # Add accessibility modifiers
dotnet_diagnostic.IDE0041.severity = error  # Use 'is null' check
dotnet_diagnostic.IDE0055.severity = error  # Formatting rules
dotnet_diagnostic.IDE0065.severity = error  # 'using' directive placement
dotnet_diagnostic.IDE0160.severity = error  # Block-scoped namespace
dotnet_diagnostic.IDE2000.severity = error  # Multiple blank lines

# -----------------------------------------------------------------------------
# 5.9 Collection Expression Rules (.NET 8+)
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0300.severity = error  # Use collection expression for array
dotnet_diagnostic.IDE0301.severity = error  # Use collection expression for empty
dotnet_diagnostic.IDE0302.severity = error  # Use collection expression for stackalloc
dotnet_diagnostic.IDE0303.severity = error  # Use collection expression for Create()
dotnet_diagnostic.IDE0304.severity = error  # Use collection expression for builder
dotnet_diagnostic.IDE0305.severity = error  # Use collection expression for fluent

# -----------------------------------------------------------------------------
# 5.10 Primary Constructor & nameof Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0290.severity = suggestion  # Use primary constructor
dotnet_diagnostic.IDE0280.severity = error       # Use nameof

# -----------------------------------------------------------------------------
# 5.11 Misc IDE Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.IDE0043.severity = error  # Format string invalid placeholder
dotnet_diagnostic.IDE0270.severity = error  # Null check can be simplified

# =============================================================================
# SECTION 6: CODE QUALITY - DESIGN (CA1xxx)
# =============================================================================

# -----------------------------------------------------------------------------
# 6.1 Type Design (CA1000-CA1099)
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA1008.severity = suggestion  # Enums should have zero value
dotnet_diagnostic.CA1012.severity = error  # Abstract types - no public constructors
dotnet_diagnostic.CA1018.severity = error  # Mark attributes with AttributeUsageAttribute
dotnet_diagnostic.CA1027.severity = none   # Mark enums with FlagsAttribute [opinionated]
dotnet_diagnostic.CA1032.severity = error  # Implement standard exception constructors
dotnet_diagnostic.CA1040.severity = suggestion  # Avoid empty interfaces
dotnet_diagnostic.CA1047.severity = error  # No protected in sealed type
dotnet_diagnostic.CA1062.severity = suggestion  # Validate public method arguments
dotnet_diagnostic.CA1063.severity = error  # Implement IDisposable correctly
dotnet_diagnostic.CA1064.severity = error  # Exceptions should be public
dotnet_diagnostic.CA1068.severity = error  # CancellationToken must come last
dotnet_diagnostic.CA1069.severity = error  # No duplicate enum values

# -----------------------------------------------------------------------------
# 6.2 Globalization (CA1300-CA1399)
# [OVERLAP GROUP] - CA culture rules vs MA0001/MA0011/MA0074
# Both kept for maximum strictness - review if too noisy
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA1304.severity = error  # Specify CultureInfo           [≈ MA0011]
dotnet_diagnostic.CA1305.severity = error  # Specify IFormatProvider        [≈ MA0011]
dotnet_diagnostic.CA1307.severity = error  # Specify StringComparison       [≈ MA0001, MA0074]
dotnet_diagnostic.CA1308.severity = suggestion  # ToUpperInvariant preference
dotnet_diagnostic.CA1309.severity = error  # Use ordinal StringComparison   [≈ MA0001, MA0074]
dotnet_diagnostic.CA1310.severity = error  # Specify StringComparison       [≈ MA0001]
dotnet_diagnostic.CA1311.severity = error  # Specify culture or invariant   [≈ MA0011]

# -----------------------------------------------------------------------------
# 6.3 Maintainability (CA1500-CA1599)
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA1500.severity = error  # Variable/field name conflict
dotnet_diagnostic.CA1501.severity = error  # Inheritance depth
dotnet_diagnostic.CA1502.severity = error  # Cyclomatic complexity
dotnet_diagnostic.CA1505.severity = error  # Maintainability index
dotnet_diagnostic.CA1507.severity = error  # Use nameof
dotnet_diagnostic.CA1508.severity = error  # Avoid dead conditional code
dotnet_diagnostic.CA1510.severity = error  # Use ArgumentNullException throw helper
dotnet_diagnostic.CA1511.severity = error  # Use ArgumentException throw helper
dotnet_diagnostic.CA1512.severity = error  # Use ArgumentOutOfRangeException throw helper
dotnet_diagnostic.CA1513.severity = error  # Use ObjectDisposedException throw helper
dotnet_diagnostic.CA1514.severity = error  # Avoid redundant length argument
dotnet_diagnostic.CA1515.severity = none   # Make public types internal (for apps)

# -----------------------------------------------------------------------------
# 6.4 Naming (CA1700-CA1799)
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA1707.severity = error  # No underscores in identifiers
dotnet_diagnostic.CA1716.severity = none   # No keyword identifiers [opinionated]
dotnet_diagnostic.CA1725.severity = error  # Parameter names should match base
dotnet_diagnostic.CA1727.severity = error  # PascalCase for named placeholders

# -----------------------------------------------------------------------------
# 6.5 Performance (CA1800-CA1899)
# [OVERLAP GROUP] - CA performance rules vs MA equivalents noted
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA1802.severity = error  # Use literals
dotnet_diagnostic.CA1805.severity = error  # No unnecessary initialization
dotnet_diagnostic.CA1806.severity = error  # Don't ignore method results
dotnet_diagnostic.CA1810.severity = error  # No static constructor when avoidable
dotnet_diagnostic.CA1812.severity = error  # Avoid uninstantiated internal classes
dotnet_diagnostic.CA1813.severity = error  # Avoid unsealed attributes
dotnet_diagnostic.CA1815.severity = none   # Override equals on structs [opinionated]
dotnet_diagnostic.CA1819.severity = suggestion  # No array properties [common pattern]
dotnet_diagnostic.CA1820.severity = error  # Test empty strings with length
dotnet_diagnostic.CA1821.severity = error  # Remove empty finalizers
dotnet_diagnostic.CA1822.severity = error  # Make member static              [≈ MA0038, MA0041 - MA DISABLED]
dotnet_code_quality.CA1822.api_surface = private, internal
dotnet_diagnostic.CA1823.severity = error  # Avoid unused private fields
dotnet_diagnostic.CA1825.severity = error  # Avoid zero-length arrays        [≈ MA0005]
dotnet_diagnostic.CA1826.severity = error  # Use indexer not Enumerable      [≈ MA0020]
dotnet_diagnostic.CA1827.severity = error  # Don't use Count() for Any()     [≈ MA0031]
dotnet_diagnostic.CA1828.severity = error  # Don't use CountAsync() for AnyAsync()
dotnet_diagnostic.CA1829.severity = error  # Use Length/Count property
dotnet_diagnostic.CA1830.severity = error  # Prefer StringBuilder overloads  [≈ MA0028]
dotnet_diagnostic.CA1831.severity = error  # Use AsSpan instead of Range indexers
dotnet_diagnostic.CA1832.severity = error  # Use AsSpan instead of Range indexers
dotnet_diagnostic.CA1833.severity = error  # Use AsSpan instead of Range indexers
dotnet_diagnostic.CA1834.severity = error  # StringBuilder.Append(char)      [≈ MA0028]
dotnet_diagnostic.CA1835.severity = error  # Prefer Memory-based ReadAsync/WriteAsync
dotnet_diagnostic.CA1836.severity = error  # Prefer IsEmpty over Count
dotnet_diagnostic.CA1837.severity = error  # Use Environment.ProcessId
dotnet_diagnostic.CA1838.severity = error  # Avoid StringBuilder for P/Invoke
dotnet_diagnostic.CA1839.severity = error  # Use Environment.ProcessPath
dotnet_diagnostic.CA1840.severity = error  # Use Environment.CurrentManagedThreadId
dotnet_diagnostic.CA1841.severity = error  # Prefer Dictionary.Contains methods
dotnet_diagnostic.CA1842.severity = error  # Don't use WhenAll with single task
dotnet_diagnostic.CA1843.severity = error  # Don't use WaitAll with single task
dotnet_diagnostic.CA1844.severity = error  # Provide memory-based Stream overrides
dotnet_diagnostic.CA1845.severity = error  # Use span-based string.Concat
dotnet_diagnostic.CA1846.severity = error  # Prefer AsSpan over Substring
dotnet_diagnostic.CA1847.severity = error  # string.Contains(char)
dotnet_diagnostic.CA1848.severity = none   # Use LoggerMessage delegates [verbose]
dotnet_diagnostic.CA1849.severity = error  # Call async in async              [≈ MA0042, MA0045]
dotnet_diagnostic.CA1850.severity = error  # Prefer static HashData
dotnet_diagnostic.CA1851.severity = error  # Possible multiple enumeration
dotnet_diagnostic.CA1852.severity = error  # Seal internal types              [≈ MA0053]
dotnet_diagnostic.CA1853.severity = error  # Unnecessary Dictionary.ContainsKey
dotnet_diagnostic.CA1854.severity = error  # Prefer TryGetValue
dotnet_diagnostic.CA1855.severity = error  # Prefer Clear over Fill
dotnet_diagnostic.CA1858.severity = error  # Use StartsWith instead of IndexOf
dotnet_diagnostic.CA1859.severity = error  # Use concrete types for performance
dotnet_diagnostic.CA1860.severity = error  # Avoid Enumerable.Any() extension  [≈ MA0112]
dotnet_diagnostic.CA1861.severity = error  # Avoid constant arrays as arguments
dotnet_diagnostic.CA1862.severity = error  # Use StringComparison overloads
dotnet_diagnostic.CA1864.severity = error  # Prefer TryAdd
dotnet_diagnostic.CA1865.severity = error  # Use string.Method(char)
dotnet_diagnostic.CA1866.severity = error  # Use string.Method(char)
dotnet_diagnostic.CA1867.severity = error  # Use string.Method(char)
dotnet_diagnostic.CA1868.severity = error  # Unnecessary Contains for sets
dotnet_diagnostic.CA1869.severity = error  # Cache JsonSerializerOptions
dotnet_diagnostic.CA1870.severity = error  # Use cached SearchValues

# .NET 9/10 Performance Rules
dotnet_diagnostic.CA1871.severity = error  # Don't pass nullable struct to ThrowIfNull
dotnet_diagnostic.CA1872.severity = error  # Prefer Convert.ToHexString

# =============================================================================
# SECTION 7: CODE QUALITY - USAGE (CA2xxx)
# =============================================================================

# -----------------------------------------------------------------------------
# 7.1 Task/Async Usage (CA2007-CA2016)
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA2007.severity = suggestion  # ConfigureAwait [app code]  [≈ MA0004 - BOTH DISABLED FOR APP CODE]
dotnet_diagnostic.CA2008.severity = error       # TaskScheduler required
dotnet_diagnostic.CA2009.severity = error       # Don't call ToImmutableCollection twice
dotnet_diagnostic.CA2011.severity = error       # Avoid infinite recursion
dotnet_diagnostic.CA2012.severity = error       # Use ValueTask correctly
dotnet_diagnostic.CA2013.severity = error       # Don't use ReferenceEquals on value types
dotnet_diagnostic.CA2014.severity = error       # Don't use stackalloc in loops
dotnet_diagnostic.CA2016.severity = error       # Forward CancellationToken   [≈ MA0032, MA0040, MA0079, MA0080]

# -----------------------------------------------------------------------------
# 7.2 Security Rules (CA2100-CA2199)
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA2100.severity = error  # Review SQL queries for vulnerabilities

# -----------------------------------------------------------------------------
# 7.3 Exception/Dispose Rules (CA2200-CA2299)
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA2200.severity = error  # Rethrow preserves stack        [≈ MA0027]
dotnet_diagnostic.CA2201.severity = error  # No reserved exception types    [≈ MA0012, MA0014]
dotnet_diagnostic.CA2208.severity = error  # ArgumentException correct      [≈ MA0015]
dotnet_diagnostic.CA2213.severity = error  # Disposable fields disposed
dotnet_diagnostic.CA2215.severity = error  # Base dispose call
dotnet_diagnostic.CA2217.severity = error  # No FlagsAttribute incorrect    [≈ MA0062]
dotnet_diagnostic.CA2244.severity = error  # No duplicate indexed element init
dotnet_diagnostic.CA2245.severity = error  # Don't assign property to itself
dotnet_diagnostic.CA2246.severity = error  # Assigning symbol and member same statement
dotnet_diagnostic.CA2248.severity = error  # Correct enum argument to HasFlag
dotnet_diagnostic.CA2249.severity = error  # Use Contains instead of IndexOf
dotnet_diagnostic.CA2250.severity = error  # Use ThrowIfCancellationRequested
dotnet_diagnostic.CA2251.severity = error  # Use string.Equals

# -----------------------------------------------------------------------------
# 7.4 Deprecated/Removed Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.CA1031.severity = none   # Don't catch general exceptions [too strict]
dotnet_diagnostic.CA1801.severity = error  # Review unused parameters (deprecated, use IDE0060)

# =============================================================================
# SECTION 8: SECURITY RULES (CA3xxx, CA5xxx)
# =============================================================================
dotnet_diagnostic.CA3001.severity = error  # SQL injection
dotnet_diagnostic.CA3002.severity = error  # XSS vulnerabilities
dotnet_diagnostic.CA3007.severity = error  # Open redirect
dotnet_diagnostic.CA5394.severity = error  # Insecure randomness

# =============================================================================
# SECTION 9: ASYNC/THREADING ANALYZERS
# =============================================================================

# -----------------------------------------------------------------------------
# 9.1 Microsoft.VisualStudio.Threading (VSTHRD) - PRIMARY
# -----------------------------------------------------------------------------
dotnet_diagnostic.VSTHRD002.severity = error  # Avoid synchronous waits
dotnet_diagnostic.VSTHRD100.severity = error  # Avoid async void
dotnet_diagnostic.VSTHRD101.severity = error  # Avoid unsupported async delegates
dotnet_diagnostic.VSTHRD103.severity = error  # Call async in async method
dotnet_diagnostic.VSTHRD107.severity = error  # Await Task within using
dotnet_diagnostic.VSTHRD110.severity = error  # Observe async results
dotnet_diagnostic.VSTHRD111.severity = none   # ConfigureAwait [disabled for app code]
dotnet_diagnostic.VSTHRD114.severity = error  # No null Task return
dotnet_diagnostic.VSTHRD200.severity = suggestion  # Async suffix naming

# -----------------------------------------------------------------------------
# 9.2 AsyncFixer
# [DISABLED] AsyncFixer02, AsyncFixer03 - overlap with VSTHRD
# -----------------------------------------------------------------------------
dotnet_diagnostic.AsyncFixer01.severity = suggestion  # Unnecessary async/await
dotnet_diagnostic.AsyncFixer02.severity = none        # [DISABLED] Use VSTHRD103 instead
dotnet_diagnostic.AsyncFixer03.severity = none        # [DISABLED] Use VSTHRD100 instead
dotnet_diagnostic.AsyncFixer04.severity = error       # Fire-forget in using block
dotnet_diagnostic.AsyncFixer05.severity = error       # Task downcasting
dotnet_diagnostic.AsyncifyInvocation.severity = error
dotnet_diagnostic.AsyncifyVariable.severity = error

# =============================================================================
# SECTION 10: MEZIANTOU.ANALYZER (MAxxxx)
# =============================================================================

# -----------------------------------------------------------------------------
# 10.1 Configuration
# -----------------------------------------------------------------------------
MA0051.maximum_lines_per_method = 80
MA0051.maximum_statements_per_method = 60
MA0011.exclude_tostring_methods = true
MA0053.public_class_should_be_sealed = true
MA0053.class_with_virtual_member_should_be_sealed = true
MA0053.exceptions_should_be_sealed = true

# -----------------------------------------------------------------------------
# 10.2 String/Culture Rules
# [OVERLAP GROUP] - Also enforced by CA1304-CA1311
# Keeping both for stricter checking - disable MA if too noisy
# -----------------------------------------------------------------------------
# MA0001 ≈ CA1307, CA1309, CA1310 (StringComparison)
# MA0011 ≈ CA1304, CA1305, CA1311 (IFormatProvider/CultureInfo)
# MA0074 ≈ CA1307, CA1309 (Equals StringComparison)
dotnet_diagnostic.MA0006.severity = suggestion  # Use string.Equals

# -----------------------------------------------------------------------------
# 10.3 Async Rules
# [OVERLAP GROUP] - Also enforced by VSTHRD and CA
# MA0045 overlaps with CA1849/VSTHRD103 - keeping for extra coverage
# -----------------------------------------------------------------------------
dotnet_diagnostic.MA0004.severity = none   # ConfigureAwait [disabled for app code, ≈ CA2007]
dotnet_diagnostic.MA0022.severity = error  # No null Task return
dotnet_diagnostic.MA0042.severity = error  # Don't use blocking calls [≈ CA1849]
dotnet_diagnostic.MA0045.severity = error  # Use async methods in async [stricter than CA1849]
dotnet_diagnostic.MA0080.severity = error  # CancellationToken with WithCancellation
dotnet_diagnostic.MA0089.severity = error  # [Specific async rule]
dotnet_diagnostic.MA0152.severity = error  # Use Unwrap instead of await twice

# -----------------------------------------------------------------------------
# 10.4 Performance Rules (unique to MA or stricter)
# -----------------------------------------------------------------------------
dotnet_diagnostic.MA0028.severity = error  # Optimize StringBuilder       [≈ CA1830, CA1834]
dotnet_diagnostic.MA0029.severity = error  # Combine LINQ methods
dotnet_diagnostic.MA0044.severity = error  # Remove useless ToString
dotnet_diagnostic.MA0063.severity = error  # Use Where before OrderBy
dotnet_diagnostic.MA0078.severity = error  # Use Cast instead of Select
dotnet_diagnostic.MA0105.severity = error  # Use lambda params not closure
dotnet_diagnostic.MA0106.severity = error  # Avoid closure with factoryArgument
dotnet_diagnostic.MA0111.severity = error  # string.Create over FormattableString

# -----------------------------------------------------------------------------
# 10.5 Design Rules
# -----------------------------------------------------------------------------
dotnet_diagnostic.MA0048.severity = suggestion  # File name must match type name
dotnet_diagnostic.MA0052.severity = error       # Enum.ToString to nameof
dotnet_diagnostic.MA0053.severity = none        # Sealed class [disabled - too noisy for records/DTOs]
dotnet_diagnostic.MA0067.severity = error       # Use Guid.Empty
dotnet_diagnostic.MA0102.severity = error       # Make member readonly
dotnet_diagnostic.MA0110.severity = error       # Regex source generator

# -----------------------------------------------------------------------------
# 10.6 Disabled Rules (overlap with CA - using CA versions)
# -----------------------------------------------------------------------------
dotnet_diagnostic.MA0038.severity = none  # Make method static [use CA1822]
dotnet_diagnostic.MA0041.severity = none  # Make property static [use CA1822]
dotnet_diagnostic.MA0018.severity = none  # No static on generic [use CA1000]

# =============================================================================
# SECTION 11: ROSLYNATOR (RCSxxxx)
# =============================================================================
dotnet_diagnostic.RCS1214.severity = error  # Unnecessary interpolated string
dotnet_diagnostic.RCS1181.severity = error  # Convert comment to documentation comment
dotnet_diagnostic.RCS1140.severity = suggestion  # Add exception to documentation comment
dotnet_diagnostic.RCS1141.severity = suggestion  # Add 'param' element to documentation comment

# =============================================================================
# SECTION 12: SONARANALYZER (Sxxxx)
# =============================================================================
dotnet_diagnostic.S125.severity = suggestion   # Commented code
dotnet_diagnostic.S2094.severity = suggestion  # Empty classes
dotnet_diagnostic.S2437.severity = warning     # Unnecessary bit operations
dotnet_diagnostic.S2479.severity = suggestion  # Control character escape
dotnet_diagnostic.S3925.severity = none        # ISerializable pattern
dotnet_diagnostic.S3963.severity = error        # "static" fields should be initialized inline
dotnet_diagnostic.S4457.severity = suggestion  # Async param check split
dotnet_diagnostic.S6602.severity = none        # Find vs FirstOrDefault

